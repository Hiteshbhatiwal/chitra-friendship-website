# ===================================================================
# A LITTLE WORLD OF CHITRA 💌 - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and set your private passphrase and secret.
# NEVER commit the actual '.env' file to source control.
# ===================================================================

# The secret passphrase Chitra will enter to unlock the website.
# Choose an inside joke, a shared school memory, or a private word.
SITE_PASSPHRASE=your_secret_school_passphrase_here

# Cryptographic secret key used to sign HttpOnly session cookies.
# Generate a random 32+ character string (e.g. openssl rand -hex 32)
SESSION_SECRET=your_random_32_character_cryptographic_secret_here

# Session expiration time in hours (default: 24 hours)
SESSION_MAX_AGE_HOURS=24
